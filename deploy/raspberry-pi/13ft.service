[Unit]
Description=13ft reader: paste a link, read the article, keep a copy
Documentation=https://github.com/egurpinar/13ft
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thirteenft
Group=thirteenft
WorkingDirectory=/opt/13ft/app
EnvironmentFile=/etc/13ft.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# One process (Flask's threaded server) instead of gunicorn's two: about
# 25 MB less memory, which matters on a 512 MB Pi Zero.
ExecStart=/opt/13ft/venv/bin/python /opt/13ft/app/portable.py
Restart=on-failure
RestartSec=15

# Pi-hole (DNS) and the camera come first. 13ft gets the lowest CPU and disk
# priority, at most 60 % of one CPU core, and a memory cap; if memory runs
# out anyway, the kernel stops 13ft before anything else.
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=10
CPUQuota=60%
MemoryHigh=110M
MemoryMax=160M
OOMScoreAdjust=900

# It only needs to read its program and write its library.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/13ft

[Install]
WantedBy=multi-user.target
